{
  "build": {
    "arduino": {
      "ldscript": "esp32s3_out.ld",
      "partitions": "default.csv",
      "memory_type": "dio_opi"
    },
    "core": "esp32",
    "extra_flags": [
      "-DELECROW_CROWPANEL_7_0_HMI",
      "-DARDUINO_USB_MODE=1",
      "-DARDUINO_RUNNING_CORE=1",
      "-DARDUINO_EVENT_RUNNING_CORE=1",
      "-DARDUINO_USB_CDC_ON_BOOT=0"
    ],
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "dio",
    "hwids": [["0x1A86", "0x7523"]],
    "mcu": "esp32s3",
    "variant": "esp32s3"
  },
  "connectivity": ["wifi"],
  "debug": {
    "openocd_target": "esp32s3.cfg"
  },
  "frameworks": ["arduino", "espidf"],
  "name": "Elecrow CrowPanel 7.0 HMI (7in 800x480 RGB, GT911 touch, sold as IoTeikXgo on Amazon)",
  "upload": {
    "flash_size": "4MB",
    "maximum_ram_size": 327680,
    "maximum_size": 4194304,
    "speed": 115200
  },
  "url": "https://github.com/Elecrow-RD/CrowPanel-7.0-HMI-ESP32-Display-800x480",
  "vendor": "Elecrow"
}
